+/* AGA-PISTORM: bus mutex so the chipset core (core 3) can use the bus while the 68k trap path (core 0) does.
+   ps_bus_lock is a plain, NON-RECURSIVE spinlock - nothing reachable from a
+   *_nolock or *_int function may call the wrappers below, it'd spin on a lock
+   it already holds. The classic port hit exactly that (ps_classic_protocol.c).
+   This file had the same trap in three places, found on review before it
+   ever ran - the little bastards never got the chance to hang anything: the
+   PiStorm32 write paths' dummy read after every chipset write went
+   through the ps_read_32 pointer (hang on the first custom register write),
+   ps_read_*_int pointed at the wrappers on PiStorm32 (check_blit_active with
+   blitwait), and the PiStorm16 odd-address 64/128-bit reads called
+   ps16_read_8/16. ps_memtest and ps_buptest use the *_int forms at boot,
+   before any other core touches the bus. */
+volatile char ps_bus_lock __attribute__((aligned(64)));
+#if defined(AGA_PISTORM) && defined(AGA_PROBES)
+/* AGA-PISTORM test kernels: who waits for the bus and who holds it, per core
+   (0 = the 68k, 2 = the housekeeper and its audio-ring writes, 3 = the
+   chipset). Each core only adds to its own slots, inside the lock; the
+   chipset core reads them once a frame (aga_glue.c, bus_* counters). Asked
+   for by the PiStorm16's choke: the chipset keeps time there, so the 68k is
+   the suspect, and on that board every CIA access it makes crosses the bus. */
+volatile uint64_t ps_bus_wait_ticks[4], ps_bus_hold_ticks[4], ps_bus_wait_max[4];
+volatile uint32_t ps_bus_count[4];
+static uint64_t ps_bus_hold_t0[4];
+static inline uint64_t psb_now(void) { uint64_t t; __asm__ volatile("mrs %0, CNTVCT_EL0" : "=r"(t)); return t; }
+static inline unsigned psb_core(void) { uint64_t m; __asm__ volatile("mrs %0, MPIDR_EL1" : "=r"(m)); return (unsigned)(m & 3); }
+static inline void ps_bus_acquire(void)
+{
+    uint64_t t0 = psb_now();
+    while (__atomic_test_and_set(&ps_bus_lock, __ATOMIC_ACQUIRE)) __asm__ volatile("yield");
+    uint64_t t1 = psb_now(), w = t1 - t0;
+    unsigned c = psb_core();
+    ps_bus_wait_ticks[c] += w;
+    if (w > ps_bus_wait_max[c]) ps_bus_wait_max[c] = w;
+    ps_bus_count[c]++;
+    ps_bus_hold_t0[c] = t1;
+}
+static inline void ps_bus_release(void)
+{
+    unsigned c = psb_core();
+    ps_bus_hold_ticks[c] += psb_now() - ps_bus_hold_t0[c];
+    __atomic_clear(&ps_bus_lock, __ATOMIC_RELEASE);
+}
+#else
+static inline void ps_bus_acquire(void) { while (__atomic_test_and_set(&ps_bus_lock, __ATOMIC_ACQUIRE)) __asm__ volatile("yield"); }
+static inline void ps_bus_release(void) { __atomic_clear(&ps_bus_lock, __ATOMIC_RELEASE); }
+#endif
