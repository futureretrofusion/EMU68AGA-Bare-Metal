+/* AGA-PISTORM: the chipset core on core 3 uses the bus (audio DAC loops) while
+   the 68k trap path uses it on core 0, so public bus calls are serialised. The
+   same wrappers exist in ps_protocol.c for the other boards. */
+/* AGA-PISTORM bus mutex.
+   ps_bus_lock is a plain, NON-RECURSIVE spinlock - nothing reachable from a
+   *_nolock or *_int function may call the wrappers below, it would spin on a
+   lock it already holds. That already bit me: the port renamed the primitives
+   to _nolock and made ps_read_8/16/32 the locking wrappers, but left the
+   internal call sites on the old names, which now meant the wrappers. The 68k
+   deadlocked on its first longword read and the machine hung on the Emu68
+   logo. ps_memtest and ps_buptest call the wrappers on purpose - they run
+   at top level, not under the lock. */
+volatile char ps_bus_lock __attribute__((aligned(64)));
+/* not static: GetIPLLevel in ExecutionLoop.c drives the same GPIO pins and
+   has to hold the same lock. Without the write buffer it held none - one
+   status read colliding with a core-3 audio write was enough to wedge the
+   CPLD - the touchiest piece of shit in this machine. Every bus read came
+   back $FF/$00 from then on: the CIA couldn't be acknowledged, and the
+   sandbox lost keyboard, timers and, at boot, the machine. */
+#if defined(AGA_PISTORM) && defined(AGA_PROBES)
+/* AGA-PISTORM test kernels: who waits for the bus and who holds it, per core
+   (0 = the 68k, 2 = the housekeeper and its audio-ring writes, 3 = the
+   chipset). Each core only adds to its own slots, inside the lock; the
+   chipset core reads them once a frame (aga_glue.c, bus_* counters). Asked
+   for by the PiStorm16's choke: the chipset keeps time there, so the 68k is
+   the suspect, and on that board every CIA access it makes crosses the bus. */
+volatile uint64_t ps_bus_wait_ticks[4], ps_bus_hold_ticks[4], ps_bus_wait_max[4];
+volatile uint32_t ps_bus_count[4];
+static uint64_t ps_bus_hold_t0[4];
+static inline uint64_t psb_now(void) { uint64_t t; __asm__ volatile("mrs %0, CNTVCT_EL0" : "=r"(t)); return t; }
+static inline unsigned psb_core(void) { uint64_t m; __asm__ volatile("mrs %0, MPIDR_EL1" : "=r"(m)); return (unsigned)(m & 3); }
+void ps_bus_acquire(void)
+{
+    uint64_t t0 = psb_now();
+    while (__atomic_test_and_set(&ps_bus_lock, __ATOMIC_ACQUIRE)) __asm__ volatile("yield");
+    uint64_t t1 = psb_now(), w = t1 - t0;
+    unsigned c = psb_core();
+    ps_bus_wait_ticks[c] += w;
+    if (w > ps_bus_wait_max[c]) ps_bus_wait_max[c] = w;
+    ps_bus_count[c]++;
+    ps_bus_hold_t0[c] = t1;
+}
+void ps_bus_release(void)
+{
+    unsigned c = psb_core();
+    ps_bus_hold_ticks[c] += psb_now() - ps_bus_hold_t0[c];
+    __atomic_clear(&ps_bus_lock, __ATOMIC_RELEASE);
+}
+#else
+void ps_bus_acquire(void) { while (__atomic_test_and_set(&ps_bus_lock, __ATOMIC_ACQUIRE)) __asm__ volatile("yield"); }
+void ps_bus_release(void) { __atomic_clear(&ps_bus_lock, __ATOMIC_RELEASE); }
+#endif
+unsigned int ps_read_8(unsigned int address) { ps_bus_acquire(); unsigned int r = ps_read_8_nolock(address); ps_bus_release(); return r; }
+unsigned int ps_read_16(unsigned int address) { ps_bus_acquire(); unsigned int r = ps_read_16_nolock(address); ps_bus_release(); return r; }
+unsigned int ps_read_32(unsigned int address) { ps_bus_acquire(); unsigned int r = ps_read_32_nolock(address); ps_bus_release(); return r; }
+uint64_t ps_read_64(unsigned int address) { ps_bus_acquire(); uint64_t r = ps_read_64_nolock(address); ps_bus_release(); return r; }
+uint128_t ps_read_128(unsigned int address) { ps_bus_acquire(); uint128_t r = ps_read_128_nolock(address); ps_bus_release(); return r; }
+void ps_write_8(unsigned int address, unsigned int data) { ps_bus_acquire(); ps_write_8_nolock(address, data); ps_bus_release(); }
+void ps_write_16(unsigned int address, unsigned int data) { ps_bus_acquire(); ps_write_16_nolock(address, data); ps_bus_release(); }
+void ps_write_32(unsigned int address, unsigned int data) { ps_bus_acquire(); ps_write_32_nolock(address, data); ps_bus_release(); }
